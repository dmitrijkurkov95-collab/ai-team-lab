  # Отдельная джоба, а не расширение qa-contract: у сьютов разный контракт на
  # окружение. Контракт-сьюту нужен один живой API, здесь — два процесса
  # (server + web-прокси), которые тесты поднимают и гасят сами. Смешать их
  # значит красить одну джобу по двум разным причинам и тянуть фронтенд
  # в каждый локальный запуск `pytest tests`.
  #
  # Порты в фикстуре выбираются свободными программно, поэтому джоба не
  # конфликтует с qa-contract даже на одном раннере.
  qa-e2e:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -r server/requirements.txt -r tests/requirements.txt pytest
      # Серверы поднимает сама фикстура — в CI ничего стартовать не нужно.
      # При падении она печатает логи обоих процессов, поэтому отдельного
      # tail-лога здесь нет.
      - run: python -m pytest tests_e2e -q
